{
  "name": "atomworks-annotation-studio",
  "displayName": "AtomWorks Annotation Studio",
  "description": "Create, inspect, and edit annotated CIFs with Mol*, Patinae, and native AtomWorks, and run the jobs of the installed Studio providers.",
  "icon": "icon.png",
  "version": "0.1.0",
  "publisher": "rfd4-proteina-team",
  "author": {
    "name": "RFD4-Proteina Team"
  },
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/baker-laboratory/atomworks-studio-dev.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/baker-laboratory/atomworks-studio-dev/tree/main/packages/vscode",
  "bugs": {
    "url": "https://github.com/baker-laboratory/atomworks-studio-dev/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "mmCIF",
    "AtomWorks",
    "Molstar",
    "Patinae",
    "protein design",
    "computational chemistry"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "annotationStudio.open",
        "title": "AtomWorks: Open Annotation Studio"
      },
      {
        "command": "annotationStudio.configureServer",
        "title": "AtomWorks: Configure Annotation Studio Server"
      },
      {
        "command": "annotationStudio.selectViewer",
        "title": "AtomWorks: Select Annotation Studio Renderer"
      }
    ],
    "configuration": {
      "title": "AtomWorks Annotation Studio",
      "properties": {
        "annotationStudio.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "URL of the running Annotation Studio web/API service."
        },
        "annotationStudio.viewerBackend": {
          "type": "string",
          "enum": [
            "patinae",
            "molstar"
          ],
          "enumDescriptions": [
            "Use Patinae/WebGPU.",
            "Use Mol*/WebGL."
          ],
          "default": "patinae",
          "description": "Molecular viewer used by the shared Annotation Studio client. Defaults to Patinae (WebGPU); Mol* (WebGL) is used only if you select it via 'Annotation Studio: Select renderer'. Renderers never fall back to one another."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "package": "pnpm compile && vsce package --no-dependencies --no-rewrite-relative-links"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.9.2",
    "ovsx": "^1.0.2",
    "typescript": "^7.0.2"
  }
}
