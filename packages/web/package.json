{
  "name": "@baker-laboratory/atomworks-studio-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:core": "wasm-pack build ../core --target web --out-dir ../web/src/wasm -- --locked",
    "dev": "pnpm build:core && vite",
    "build": "pnpm build:core && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "node tests/smoke.mjs"
  },
  "dependencies": {
    "@baker-laboratory/patinae-viewer": "file:vendor/patinae-viewer-0.4.5-studio.1.tgz",
    "molstar": "5.11.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@types/node": "^26.1.1",
    "openapi-typescript": "^7.13.0",
    "playwright-core": "^1.61.1",
    "sass": "^1.101.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
