diff --git a/web/ts/src/core/cif.ts b/web/ts/src/core/cif.ts
new file mode 100644
index 0000000..7c6b2ef
--- /dev/null
+++ b/web/ts/src/core/cif.ts
@@ -0,0 +1,78 @@
+type CifToken = { value: string; control: boolean };
+
+function tokenizeCif(input: string): CifToken[] {
+  const tokens: CifToken[] = [];
+  for (let index = 0; index < input.length;) {
+    if (/\s/.test(input[index])) {
+      index += 1;
+      continue;
+    }
+    if (input[index] === "#") {
+      while (index < input.length && input[index] !== "\n") index += 1;
+      continue;
+    }
+    if (input[index] === ";" && (index === 0 || input[index - 1] === "\n")) {
+      const start = ++index;
+      while (index < input.length && !(input[index] === ";" && input[index - 1] === "\n")) {
+        index += 1;
+      }
+      if (index === input.length) throw new Error("Unterminated CIF text field");
+      tokens.push({ value: input.slice(start, index), control: false });
+      index += 1;
+      continue;
+    }
+    const quote = input[index] === "'" || input[index] === '"' ? input[index++] : null;
+    const start = index;
+    if (quote) {
+      while (index < input.length && input[index] !== quote) index += 1;
+      if (index === input.length) throw new Error("Unterminated quoted CIF value");
+      tokens.push({ value: input.slice(start, index), control: false });
+      index += 1;
+    } else {
+      while (index < input.length && !/\s/.test(input[index]) && input[index] !== "#") {
+        index += 1;
+      }
+      const value = input.slice(start, index);
+      tokens.push({
+        value,
+        control: value === "loop_" || value === "stop_" || value.startsWith("data_")
+          || value.startsWith("save_") || value.startsWith("_"),
+      });
+    }
+  }
+  return tokens;
+}
+
+/**
+ * Return zero-based document rows where an `_atom_site` boolean column is true.
+ *
+ * This follows CIF token boundaries, including quoted and semicolon-delimited
+ * values, instead of assuming one whitespace-delimited atom per line.
+ */
+export function parseAtomSiteBooleanColumn(cif: string, columnName: string): number[] {
+  const tokens = tokenizeCif(cif);
+  for (let loop = 0; loop < tokens.length; loop += 1) {
+    if (!tokens[loop].control || tokens[loop].value !== "loop_") continue;
+    let cursor = loop + 1;
+    const headers: string[] = [];
+    while (cursor < tokens.length && tokens[cursor].control && tokens[cursor].value.startsWith("_")) {
+      headers.push(tokens[cursor++].value);
+    }
+    if (!headers.length || !headers.every((header) => header.startsWith("_atom_site."))) continue;
+    const column = headers.indexOf(columnName);
+    if (column < 0) return [];
+    const rows: number[] = [];
+    let valueIndex = 0;
+    while (cursor < tokens.length) {
+      if (valueIndex % headers.length === 0 && tokens[cursor].control) break;
+      if (valueIndex % headers.length === column && /^(?:true|yes|1)$/i.test(tokens[cursor].value)) {
+        rows.push(Math.floor(valueIndex / headers.length));
+      }
+      valueIndex += 1;
+      cursor += 1;
+    }
+    if (valueIndex % headers.length !== 0) throw new Error("Ragged _atom_site loop");
+    return rows;
+  }
+  return [];
+}
