diff --git a/web/ts/tests/cif.test.ts b/web/ts/tests/cif.test.ts
new file mode 100644
index 0000000..0594440
--- /dev/null
+++ b/web/ts/tests/cif.test.ts
@@ -0,0 +1,47 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { parseAtomSiteBooleanColumn } from "../src/core/cif.ts";
+
+const COLUMN = "_atom_site.mask_coordinate_1_atom";
+
+test("parses boolean atom-site values by document row", () => {
+  const cif = `data_test
+loop_
+_atom_site.id
+_atom_site.label_atom_id
+${COLUMN}
+17 'C A' False
+4 N True
+99 O 1
+#
+`;
+
+  assert.deepEqual(parseAtomSiteBooleanColumn(cif, COLUMN), [1, 2]);
+});
+
+test("does not treat quoted control words as loop terminators", () => {
+  const cif = `data_test
+loop_
+_atom_site.id
+_atom_site.label_atom_id
+${COLUMN}
+1 'loop_' yes
+2 C no
+#
+`;
+
+  assert.deepEqual(parseAtomSiteBooleanColumn(cif, COLUMN), [0]);
+});
+
+test("rejects ragged atom-site loops", () => {
+  const cif = `data_test
+loop_
+_atom_site.id
+${COLUMN}
+1
+#
+`;
+
+  assert.throws(() => parseAtomSiteBooleanColumn(cif, COLUMN), /Ragged/);
+});
