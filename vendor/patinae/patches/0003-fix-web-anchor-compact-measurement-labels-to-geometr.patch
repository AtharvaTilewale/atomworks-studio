From 2bf8d2cc6dde586e80a728f0d8718ba0bbb584f0 Mon Sep 17 00:00:00 2001
From: Kieran Didi <kieran.didi@gmail.com>
Date: Fri, 24 Jul 2026 07:15:31 -0700
Subject: [PATCH 3/3] fix(web): anchor compact measurement labels to geometry

Render measurement text as a compact overlay immediately above its projected geometry midpoint for clearer molecular inspection.
---
 web/ts/src/core/labels.ts | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/web/ts/src/core/labels.ts b/web/ts/src/core/labels.ts
index 10a65f4..3b0e562 100644
--- a/web/ts/src/core/labels.ts
+++ b/web/ts/src/core/labels.ts
@@ -50,13 +50,20 @@ export class LabelOverlay {
       el.textContent = label.text;
 
       if (label.kind === "atom") {
+        el.className = "patinae-atom-label";
         el.style.color = "white";
         el.style.fontSize = "14px";
         el.style.transform = "translateY(-100%)";
+        el.style.padding = "0";
+        el.style.background = "transparent";
       } else {
-        el.style.color = "#ffff00";
-        el.style.fontSize = "13px";
-        el.style.transform = "translate(-50%, -50%)";
+        el.className = "patinae-measurement-label";
+        el.style.color = "#ffff66";
+        el.style.fontSize = "11px";
+        el.style.transform = "translate(-50%, -115%)";
+        el.style.padding = "1px 3px";
+        el.style.background = "rgba(0, 0, 0, 0.6)";
+        el.style.borderRadius = "2px";
       }
 
       el.style.display = "";
-- 
