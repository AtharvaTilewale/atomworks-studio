+        let result = evaluate_selection(&mut session, "alpha and name CA").unwrap();
+
+        assert_eq!(result.expression, "alpha and name CA");
+        assert_eq!(result.atom_count, 1);
+        assert_eq!(
+            result.objects,
+            vec![ObjectAtomIndices {
+                object_name: "model".to_string(),
+                atom_indices: vec![1],
+            }]
