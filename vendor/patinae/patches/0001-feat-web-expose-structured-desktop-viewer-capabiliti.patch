+
+        let details = selection_details(&mut session, "beta").unwrap().unwrap();
+
+        assert_eq!(details.name, "beta");
+        assert!(!details.visible);
+        assert_eq!(details.atom_count, 1);
+        assert_eq!(details.objects[0].atom_indices, vec![2]);
+        assert!(selection_details(&mut session, "missing")
+            .unwrap()
+            .is_none());
+    }
+
+    #[test]
+    fn command_catalog_is_sorted_and_marks_host_only_commands() {
+        let executor = CommandExecutor::new();
