+    /// Generate dashed world-space line segments for rendering this measurement.
+    pub fn line_segments(&self) -> Vec<(Vec3, Vec3)> {
+        let mut segments = Vec::new();
+        match self.kind {
+            MeasurementType::Distance => {
+                append_dashed_line(&mut segments, self.points[0], self.points[1]);
+            }
+            MeasurementType::Angle => {
+                append_dashed_line(&mut segments, self.points[0], self.points[1]);
+                append_dashed_line(&mut segments, self.points[1], self.points[2]);
+                if let Some(arc) = ArcGeometry::for_angle(
+                    self.points[0],
+                    self.points[1],
+                    self.points[2],
+                    self.value,
+                ) {
+                    append_dashed_arc(&mut segments, &arc);
+                }
+            }
+            MeasurementType::Dihedral => {
+                append_dashed_line(&mut segments, self.points[0], self.points[1]);
+                append_dashed_line(&mut segments, self.points[1], self.points[2]);
+                append_dashed_line(&mut segments, self.points[2], self.points[3]);
+                if let Some(arc) = ArcGeometry::for_dihedral(
+                    self.points[0],
+                    self.points[1],
+                    self.points[2],
+                    self.points[3],
+                    self.value,
+                ) {
+                    append_dashed_arc(&mut segments, &arc);
+                }
+            }
+        }
+        segments
+    }
+}
+
+fn append_dashed_line(segments: &mut Vec<(Vec3, Vec3)>, p1: Vec3, p2: Vec3) {
+    let delta = p2 - p1;
+    let length = delta.magnitude();
+    if length < 1e-6 {
+        return;
+    }
+    let direction = delta / length;
+    let mut offset = 0.0;
+    while offset < length {
+        let end = (offset + DASH_LENGTH).min(length);
+        segments.push((p1 + direction * offset, p1 + direction * end));
+        offset += DASH_LENGTH + GAP_LENGTH;
+    }
+}
+
+fn append_dashed_arc(segments: &mut Vec<(Vec3, Vec3)>, arc: &ArcGeometry) {
+    let radius = arc.x_axis.magnitude();
+    if radius < 1e-6 || arc.arc_angle.abs() < 1e-6 {
+        return;
+    }
+    let sign = arc.arc_angle.signum();
+    let sweep = arc.arc_angle.abs();
+    let dash_angle = DASH_LENGTH / radius;
+    let gap_angle = GAP_LENGTH / radius;
+    let mut angle = 0.0;
+    while angle < sweep {
+        let end = (angle + dash_angle).min(sweep);
+        let start_angle = angle * sign;
+        let end_angle = end * sign;
+        let start = arc.center + arc.x_axis * start_angle.cos() + arc.y_axis * start_angle.sin();
+        let end = arc.center + arc.x_axis * end_angle.cos() + arc.y_axis * end_angle.sin();
+        segments.push((start, end));
+        angle += dash_angle + gap_angle;
+    }
 }
 
