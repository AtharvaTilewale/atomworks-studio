+const DEFAULT_MEASUREMENT_COLOR: [f32; 4] = [1.0, 1.0, 0.0, 1.0];
+
+fn expected_measurement_points(kind: &MeasurementRequestKind) -> usize {
+    match kind {
+        MeasurementRequestKind::Distance => 2,
+        MeasurementRequestKind::Angle => 3,
+        MeasurementRequestKind::Dihedral => 4,
+    }
+}
+
+fn request_kind_name(kind: &MeasurementRequestKind) -> &'static str {
+    match kind {
+        MeasurementRequestKind::Distance => "distance",
+        MeasurementRequestKind::Angle => "angle",
+        MeasurementRequestKind::Dihedral => "dihedral",
+    }
+}
+
+fn validate_color(color: [f32; 4]) -> Result<[f32; 4], String> {
+    if color
+        .iter()
+        .any(|component| !component.is_finite() || !(0.0..=1.0).contains(component))
+    {
+        return Err(
+            "Measurement color must contain four finite RGBA values between 0 and 1".to_string(),
+        );
+    }
+    Ok(color)
+}
+
+fn validate_geometry(
+    kind: &MeasurementRequestKind,
+    points: &[lin_alg::f32::Vec3],
+) -> Result<(), String> {
+    const EPSILON: f32 = 1e-6;
+    match kind {
+        MeasurementRequestKind::Distance => {
+            if (points[1] - points[0]).magnitude() < EPSILON {
+                return Err("Distance measurement requires two distinct points".to_string());
+            }
+        }
+        MeasurementRequestKind::Angle => {
+            let first = points[0] - points[1];
+            let second = points[2] - points[1];
+            if first.magnitude() < EPSILON || second.magnitude() < EPSILON {
+                return Err(
+                    "Angle measurement requires points distinct from its vertex".to_string()
+                );
+            }
+        }
+        MeasurementRequestKind::Dihedral => {
+            let first = points[1] - points[0];
+            let central = points[2] - points[1];
+            let last = points[3] - points[2];
+            if central.magnitude() < EPSILON
+                || first.cross(central).magnitude() < EPSILON
+                || central.cross(last).magnitude() < EPSILON
+            {
+                return Err(
+                    "Dihedral measurement requires a non-zero central bond and non-collinear planes"
+                        .to_string(),
+                );
+            }
+        }
+    }
+    Ok(())
+}
+
+fn resolve_measurement_request(
+    session: &mut Session,
+    request: MeasurementRequest,
+) -> Result<(String, Measurement), String> {
+    if request.name.trim().is_empty() {
+        return Err("Measurement name cannot be empty".to_string());
+    }
+
+    let expected = expected_measurement_points(&request.kind);
+    let point_values = match (request.selections, request.points) {
+        (Some(_), Some(_)) => {
+            return Err(format!(
+                "{} measurement must provide exactly one of selections or points",
+                request_kind_name(&request.kind)
+            ))
+        }
+        (None, None) => {
+            return Err(format!(
+                "{} measurement must provide selections or points",
+                request_kind_name(&request.kind)
+            ))
+        }
+        (Some(selections), None) => {
+            if selections.len() != expected {
+                return Err(format!(
+                    "{} measurement requires exactly {expected} selections",
+                    request_kind_name(&request.kind)
+                ));
+            }
+            let mut points = Vec::with_capacity(expected);
+            for selection in selections {
+                if selection.trim().is_empty() {
+                    return Err("Measurement selections cannot be empty".to_string());
+                }
+                points.push(first_selected_position(session, &selection)?);
+            }
+            points
+        }
+        (None, Some(points)) => {
+            if points.len() != expected {
+                return Err(format!(
+                    "{} measurement requires exactly {expected} points",
+                    request_kind_name(&request.kind)
+                ));
+            }
+            if points
+                .iter()
+                .flatten()
+                .any(|component| !component.is_finite())
+            {
+                return Err("Measurement points must contain finite coordinates".to_string());
+            }
+            points
+                .into_iter()
+                .map(|point| lin_alg::f32::Vec3::new(point[0], point[1], point[2]))
+                .collect()
+        }
+    };
+    validate_geometry(&request.kind, &point_values)?;
+
+    let color = validate_color(request.color.unwrap_or(DEFAULT_MEASUREMENT_COLOR))?;
+    let mut measurement = match request.kind {
+        MeasurementRequestKind::Distance => {
+            Measurement::distance(point_values[0], point_values[1], color)
+        }
+        MeasurementRequestKind::Angle => {
+            Measurement::angle(point_values[0], point_values[1], point_values[2], color)
+        }
+        MeasurementRequestKind::Dihedral => Measurement::dihedral(
+            point_values[0],
+            point_values[1],
+            point_values[2],
+            point_values[3],
+            color,
+        ),
+    };
+    if let Some(label) = request.label {
+        measurement.label = label;
+    }
+    Ok((request.name, measurement))
+}
+
+fn evaluate_selection(
+    session: &mut Session,
+    expression: &str,
+) -> Result<SelectionEvaluation, String> {
+    let mut needs_redraw = false;
+    let adapter = SessionAdapter {
+        session,
+        render_context: None,
+        default_size: (1, 1),
+        needs_redraw: &mut needs_redraw,
+        async_fetch_fn: None,
+    };
+    let (atom_count, results) =
+        patinae_cmd::commands::selecting::select_with_context(&adapter, expression)
+            .map_err(|e| format!("Selection error: {e}"))?;
+    let objects = results
+        .into_iter()
+        .filter_map(|(object_name, result)| {
+            let atom_indices: Vec<usize> = result.raw_indices().collect();
+            (!atom_indices.is_empty()).then_some(ObjectAtomIndices {
+                object_name,
+                atom_indices,
+            })
+        })
+        .collect();
+    Ok(SelectionEvaluation {
+        expression: expression.to_string(),
+        atom_count,
+        objects,
+    })
+}
+
+fn selection_details(
+    session: &mut Session,
+    name: &str,
+) -> Result<Option<SelectionDetails>, String> {
+    let Some(entry) = session.selections.get(name) else {
+        return Ok(None);
+    };
+    let expression = entry.expression.clone();
+    let visible = entry.visible;
+    let evaluation = evaluate_selection(session, &expression)?;
+    Ok(Some(SelectionDetails {
+        name: name.to_string(),
+        expression,
+        visible,
+        atom_count: evaluation.atom_count,
+        objects: evaluation.objects,
+    }))
+}
+
+fn command_is_web_safe(name: &str) -> (bool, Option<&'static str>) {
+    match name {
+        "load" | "load_traj" | "fetch" => (
+            false,
+            Some("use PatinaeViewer.loadData/loadUrl or executeAsync in the browser"),
+        ),
+        "save" | "cd" | "pwd" | "ls" | "run" => (false, Some("requires local filesystem access")),
+        "png" => (false, Some("browser capture renderer is not implemented")),
+        "quit" => (
+            false,
+            Some("application lifecycle command is not available on web"),
+        ),
+        _ => (true, None),
+    }
+}
+
+fn command_catalog(executor: &CommandExecutor) -> Vec<CommandMetadata> {
+    let registry = executor.registry();
+    let mut names: Vec<&str> = registry.names().collect();
+    names.sort_unstable();
+    names
+        .into_iter()
+        .filter_map(|name| registry.get(name))
+        .map(|command| {
+            let (web_safe, unavailable_reason) = command_is_web_safe(command.name());
+            CommandMetadata {
+                name: command.name().to_string(),
+                aliases: command
+                    .aliases()
+                    .iter()
+                    .map(|alias| (*alias).to_string())
+                    .collect(),
+                description: command.description().to_string(),
+                usage: command.usage().to_string(),
+                arguments: command.arguments().to_string(),
+                help: command.help().to_string(),
+                web_safe,
+                unavailable_reason,
+            }
+        })
+        .collect()
+}
+
+fn measurement_kind(kind: MeasurementType) -> &'static str {
+    match kind {
+        MeasurementType::Distance => "distance",
+        MeasurementType::Angle => "angle",
+        MeasurementType::Dihedral => "dihedral",
+    }
+}
+
+fn measurement_info(name: &str, object: &MeasurementObject) -> MeasurementInfo {
+    MeasurementInfo {
+        name: name.to_string(),
+        enabled: object.is_enabled(),
+        measurements: object
+            .measurements()
+            .iter()
+            .map(|measurement| MeasurementEntryInfo {
+                kind: measurement_kind(measurement.kind),
+                value: measurement.value,
+                label: measurement.label.clone(),
+                points: measurement
+                    .points
+                    .iter()
+                    .map(|point| [point.x, point.y, point.z])
+                    .collect(),
+                color: measurement.color,
+            })
+            .collect(),
+    }
+}
+
+fn first_selected_position(
+    session: &mut Session,
+    expression: &str,
+) -> Result<lin_alg::f32::Vec3, String> {
+    let evaluation = evaluate_selection(session, expression)?;
+    for selected in evaluation.objects {
+        let Some(index) = selected.atom_indices.first().copied() else {
+            continue;
+        };
+        let Some(object) = session.registry.get_molecule(&selected.object_name) else {
+            continue;
+        };
+        if let Some(position) = object
+            .molecule()
+            .get_coord_set(object.display_state())
+            .and_then(|coords| coords.get_atom_coord(patinae_mol::AtomIndex(index as u32)))
+        {
+            return Ok(position);
+        }
+    }
+    Err(format!(
+        "Selection error: no atoms found in selection '{expression}'"
+    ))
+}
