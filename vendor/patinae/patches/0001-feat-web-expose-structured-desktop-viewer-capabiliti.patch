+
+        assert!(catalog.windows(2).all(|pair| pair[0].name < pair[1].name));
+        let distance = catalog
+            .iter()
+            .find(|entry| entry.name == "distance")
+            .unwrap();
+        assert!(distance.web_safe);
+        assert!(!distance.usage.is_empty());
+        let save = catalog.iter().find(|entry| entry.name == "save").unwrap();
+        assert!(!save.web_safe);
